# Frontend environment. Copy to .env.local for local overrides (git-ignored).
# Nothing here is secret: everything prefixed VITE_ ends up in the public JS bundle.

# Where the Vite dev server proxies /api during `npm run dev`.
VITE_DEV_API_TARGET=http://localhost:8080

# Optional error alerts (Sentry). Leave empty to turn them off. Set it in Vercel for production builds;
# see docs/DEPLOYMENT.md. Not secret (it's in the public bundle), but keep it out of Git anyway.
# VITE_SENTRY_DSN=
