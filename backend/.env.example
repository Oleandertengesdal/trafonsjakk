# Copy to backend/.env for local overrides (that file is git-ignored). Never commit real values.
# Local defaults already work with docker-compose; you only need this to override them.

SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/trafonsjakk
DATABASE_USERNAME=trafonsjakk
DATABASE_PASSWORD=trafonsjakk

# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=

# Lets the very first account register as admin. Only works while there are no users.
BOOTSTRAP_INVITE_CODE=let-me-in
